# Build artifacts. build*/ rather than build/ because the same working tree is
# built on both platforms: a container sharing the tree over a mount needs its
# own directory, or its ELF objects land where the macOS build expects Mach-O.
# See docs/system/ci.md.
build*/
*.o
*.out
*.lst
*.map
*.bin

# Local agent tooling state
.claude/

# macOS
.DS_Store

# Editors
*.swp
*~
.idea/
.vscode/
